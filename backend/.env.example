# PostgreSQL
DB_NAME=decisio_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Frontend URL used in invitation / password reset e-mails
# Replace with your public frontend URL for ngrok/cloudflared tests.
FRONTEND_BASE_URL=http://localhost:8080

# SMTP / e-mail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=DecisioBI <your-email@example.com>

# OpenAI
OPENAI_API_KEY=
OPENAI_KPI_MODEL=gpt-4o
