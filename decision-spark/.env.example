# Backend API Configuration
# Leave empty in local dev if you want the frontend dev server to proxy /api to localhost:8000.
# Set a public backend URL only if you explicitly expose the backend separately.
VITE_API_BASE_URL=
VITE_API_VERSION=v1

# Optional: For production builds
# VITE_API_BASE_URL=https://api.decisiobi.com

# For public tunnel tests, replace with your backend public URL:
# VITE_API_BASE_URL=https://your-backend-tunnel.trycloudflare.com
